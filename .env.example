# =====================================================================
# ECHOHANDS 5.0 - Configuration & API Key Slots
# =====================================================================
# Rename this file to .env and add your private API keys.
# The system operates 100% offline using the local dual-brain neural engine
# if no API keys are provided. When configured, keys are used for real-time
# arbitration with automatic multi-key zero-context-loss fallback.

# Primary verification slot (Fast inference, generous rate limit)
GROQ_API_KEY=your_groq_api_key_here

# Secondary fallback slot (Multimodal reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Tertiary fallback slot
OPENAI_API_KEY=your_openai_api_key_here
