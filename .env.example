# =====================================================================
# ECHOHANDS 5.0 - Configuration & API Key Slots
# =====================================================================
# For Local Development:
#   Rename this file to .env and add your private API keys.
#
# For Vercel Cloud Deployment:
#   Add these environment variables in your Vercel Project Settings -> Environment Variables.
#
# The system operates 100% offline using the local dual-brain neural engine
# and client-side 3D avatar even if no API keys are provided. When configured,
# keys are used for real-time cloud LLM verification & arbitration.

# Primary verification slot (Ultra-fast LLM inference, generous rate limits)
GROQ_API_KEY=your_groq_api_key_here

# Secondary fallback slot (Multimodal reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Tertiary fallback slot
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom Vercel public URL (if syncing across custom domains)
# VERCEL_PUBLIC_URL=https://your-project.vercel.app
